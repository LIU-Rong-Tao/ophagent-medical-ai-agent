      "test_sha256": "648ac4584ce055314f4fb048b40daf27b524a4765e063d9f5e412c8c079451ca",
      "one_time_retrospective_forward_required": false,
      "incremental_online_encoder_forward_calls": 0
    }
  },
  "legal_feature_contract": {
    "allowed": [
      "same_forward_scout_classification_head_input",
      "scout_probabilities",
      "scout_entropy",
      "scout_margin",
      "scout_severe_probability_mass",
      "development_fold_internal_route_history",
      "development_fold_internal_unlabeled_reference_shift"
    ],
    "forbidden": [
      "current_case_expert_output",
      "current_case_expert_embedding",
      "retrospective_evaluation_outcome_for_fit_selection_or_threshold",
      "dataset_id_as_predictor",
      "additional_uncosted_scout_forward",
      "patient_or_private_identifier"
    ]
  },
  "model_contract": {
    "implementation": "separate_fixed_L2_logistic_for_corrected_and_introduced",
    "embedding_standardization": "training_fold_only",
    "pca_components": 32,
    "pca_whiten": false,
    "pca_fit_scope": "training_fold_only",
    "route_profile_fit_scope": "training_fold_only",
    "development_outer_folds": 5,
    "safe_pool_multiplier": 2.0,
    "hyperparameter_search": false,
    "formal_model_search": false
  },
  "comparison_contract": {
    "curve_budgets": [
      0.05,
      0.1,
      0.15,
      0.2,
      0.25,
      0.3
    ],
    "decision_budgets": [
      0.1,
      0.2,
      0.3
    ],
    "same_budget_policies": [
      "entropy",
      "margin",
      "prior_simple_gate",
      "scout_representation"
    ],
    "reference_policies": [
      "scout_only",
      "always_expert"
    ],
    "strongest_comparator_selection": "development_OOF_only_lexicographic_net_corrected_negative_introduced",
    "same_budget_requires_equal_call_count": true,
    "bootstrap_replicates": 1000,
    "bootstrap_unit": "exact_image_analysis_unit"
  },
  "decision_contract": {
    "allowed": [
      "REPRESENTATION_GO",
      "ROUTE_SPECIFIC_GO",
      "NO_IMPROVEMENT"
    ],
    "route_dominance": "corrected_not_lower_and_introduced_not_higher_and_net_strictly_higher_than_development_locked_strongest_comparator",
    "minimum_dominant_decision_budgets_per_route": 2,
    "must_include_budget": 0.3,
    "budget_0_3_paired_net_ci_lower_must_be_nonnegative": true,
    "REPRESENTATION_GO": "At least two routes with at least two distinct Scout models satisfy the frozen route rule.",
    "ROUTE_SPECIFIC_GO": "At least one route satisfies the frozen route rule but the multi-Scout rule is not met.",
    "NO_IMPROVEMENT": "No route satisfies the frozen route rule.",
    "boundary": "A positive result is retrospective image-level evidence and cannot grant route eligibility."
  },
  "required_outputs": [
    "core_results.csv",
    "risk_budget_comparison.png",
    "research_report.md"
  ]
}
