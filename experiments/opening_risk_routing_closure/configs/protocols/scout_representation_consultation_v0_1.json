    "prior_simple_gate_results_sha256": "a4fc7dad020b28b044565781fc8f5c119b90e0e510fff27b788bb082d7d5a134",
    "qualified_route_ids": [
      "aptos_dr_5class::flair__to__swin_tiny",
      "aptos_dr_5class::retfound_green__to__retfound_cfp",
      "aptos_dr_5class::retfound_green__to__swin_tiny"
    ],
    "route_selection_may_read_retrospective_evaluation": false
  },
  "analysis_scope": {
    "task_id": "aptos_dr_5class",
    "dataset_id": "APTOS2019",
    "development_split": "development",
    "evaluation_split": "retrospective_frozen",
    "analysis_unit": "exact_image_group_after_confirmed_duplicate_exclusion",
    "patient_level_claim_allowed": false,
    "retrospective_only": true,
    "independent_patient_level_confirmation_required": true
  },
  "representation_assets": {
    "flair": {
      "representation": "classification_head_input",
      "dimension": 512,
