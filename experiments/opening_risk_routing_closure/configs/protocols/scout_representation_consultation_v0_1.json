      "test_sha256": "2442570b9d8e07d8599728a3360cc8423019c828ebd93014979c4e1b6ff233e2",
      "one_time_retrospective_forward_required": true,
      "incremental_online_encoder_forward_calls": 0
    },
    "retfound_green": {
